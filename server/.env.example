# ==========================================================
# ProjectA Server Environment Configuration
# ==========================================================

# ---- App ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:4200

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/projecta
MONGO_URI_TEST=mongodb://127.0.0.1:27017/projecta_test

# ---- JWT ----
JWT_ACCESS_SECRET=change_this_access_secret_please
JWT_REFRESH_SECRET=change_this_refresh_secret_please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=projectA
USE_SECURE_COOKIE_REFRESH=false

# ---- Password Policy ----
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# ---- Payload Encryption (AES-256-GCM) ----
ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd
ENCRYPTION_EXEMPT_PATHS=/api/v1/auth/login,/api/v1/auth/refresh-token

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Seed - Super Admin ----
SEED_SUPERADMIN_EMAIL=superadmin@projecta.com
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_SUPERADMIN_FIRSTNAME=Super
SEED_SUPERADMIN_LASTNAME=Admin

# ---- WhatsApp Provider: "meta" or "twilio" ----
WHATSAPP_PROVIDER=meta
WHATSAPP_ENABLED=false

# Meta (WhatsApp Cloud API)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v20.0

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- SMTP (Settings module default) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ProjectA <no-reply@projecta.com>"

# ---- Reminder Cron ----
REMINDER_CRON_SCHEDULE=0 9 * * *
REMINDER_TIMEZONE=Asia/Kolkata

# ---- Logging ----
LOG_LEVEL=info
